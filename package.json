{
  "name": "@uniswap/uniswapx-parametrization-api",
  "version": "0.0.1",
  "bin": {
    "app": "./dist/bin/app.js"
  },
  "license": "UNLICENSED",
  "repository": "https://github.com/Uniswap/uniswapx-parameterization-api",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist cdk.out",
    "watch": "tsc -w",
    "test": "run-s build test:*",
    "test:unit": "jest --detectOpenHandles --forceExit --testPathIgnorePatterns test/integ dist/",
    "test:integ": "ts-mocha -p tsconfig.cdk.json -r dotenv/config test/integ/**/*.test.ts --timeout 120000 --exit",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"lib/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\" --write",
    "fix:eslint": "eslint lib test bin --ext .ts --fix",
    "lint": "run-s lint:*",
    "lint:prettier": "prettier --check \"lib/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\"",
    "lint:eslint": "eslint lib test bin --ext .ts",
    "deploy": "yarn build && cdk deploy"
  },
  "devDependencies": {
    "@shelf/jest-dynamodb": "^3.4.1",
    "@types/aws-lambda": "^8.10.108",
    "@types/bunyan": "^1.8.8",
    "@types/chai": "^4.3.4",
    "@types/chai-as-promised": "^7.1.5",
    "@types/chai-subset": "^1.3.3",
    "@types/jest": "^29.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.8",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "aws-cdk": "2.1133.0",
    "esbuild": "^0.15.12",
    "eslint": "^8.26.0",
    "eslint-plugin-import": "^2.26.0",
    "ethers": "^5.7.2",
    "jest": "^29.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.1.1",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "@aws-cdk/aws-redshift-alpha": "2.262.1-alpha.0",
    "@aws-sdk/client-dynamodb": "^3.386.0",
    "@aws-sdk/client-firehose": "^3.490.0",
    "@aws-sdk/client-kms": "^3.513.0",
    "@aws-sdk/client-redshift-data": "^3.382.0",
    "@aws-sdk/client-s3": "^3.304.0",
    "@aws-sdk/lib-dynamodb": "^3.386.0",
    "@swc/core": "^1.3.101",
    "@swc/jest": "^0.2.29",
    "@uniswap/sdk-core": "^7.18.0",
    "@uniswap/signer": "0.0.3-beta.4",
    "@uniswap/smart-order-router": "^4.22.20",
    "@uniswap/uniswapx-sdk": "3.0.10",
    "aws-cdk-lib": "^2.262.1",
    "aws-embedded-metrics": "^4.1.0",
    "aws-sdk": "^2.1542.0",
    "axios": "^1.16.0",
    "axios-retry": "^3.4.0",
    "bunyan": "^1.8.15",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "constructs": "^10.1.137",
    "dotenv": "^16.0.3",
    "dynamodb-toolbox": "^0.8.5",
    "joi": "^17.7.0",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "uuid": "^9.0.0"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "organizeImportsSkipDestructiveCodeActions": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "resolutions": {
    "elliptic": "6.6.1"
  }
}
